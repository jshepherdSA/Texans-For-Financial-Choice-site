# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Assets from another project keep appearing under public/images (a Kentucky
# districts map, 2026-2027 officers, a duplicate stock/ tree). They are not
# part of this site and were committed once by an over-broad `git add -A`.
# Ignored so that cannot happen again; the files are left on disk untouched.
public/images/community/
public/images/gallery/
public/images/hero/
public/images/stock/
public/images/ky-map-districts.png
public/images/newsletter-cover.jpg
public/images/officers-*.jpg
